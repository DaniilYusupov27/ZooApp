<Page x:Class="ZooApp.Pages.AnimalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ZooApp.Pages" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      d:DesignHeight="500"
      d:DesignWidth="900"
      Title="AnimalPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0"
              Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <xctk:WatermarkTextBox x:Name="txtBoxSearch"
                                   Watermark="Поиск &#128269;"
                                   HorizontalContentAlignment="Right"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   TextChanged="txtBoxSearch_TextChanged"/>

            <Grid Grid.Column="1"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поле: "
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Grid.Column="0"
                           Grid.Row="0"/>

                <ComboBox x:Name="cmbBoxFilterField"
                          Grid.Column="1"
                          Grid.Row="0"
                          SelectionChanged ="cmbBoxFilterField_SelectionChanged" >
                    <ComboBox.Items>
                        <TextBlock Text="Не выбрано"/>
                        <TextBlock Text="Год поступления"/>
                        <TextBlock Text="Год рождения"/>
                    </ComboBox.Items>
                </ComboBox>
                <TextBlock Text="Значение: "
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Grid.Column="2"
                           Grid.Row="0"/>

                <ComboBox x:Name="cmbBoxFilterType"
                          Grid.Column="3"
                          Grid.Row="0"
                          SelectionChanged="cmbBoxFilterType_SelectionChanged">
                    <ComboBox.Items>
                        <TextBlock Text="Не задано"/>
                    </ComboBox.Items>

                </ComboBox>
            </Grid>
            <Grid Grid.Column="2"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поле: "
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Grid.Column="0"
                           Grid.Row="0"/>

                <ComboBox x:Name="cmbBoxSortField"
                          Grid.Column="1"
                          Grid.Row="0"
                          SelectionChanged="cmbBoxSortField_SelectionChanged">
                    <ComboBox.Items>
                        <TextBlock Text="№ студенческого билета"/>
                        <TextBlock Text="Фамилия"/>
                        <TextBlock Text="Имя"/>
                        <TextBlock Text="Отчество"/>
                        <TextBlock Text="Дата рождения"/>
                    </ComboBox.Items>

                </ComboBox>
                <TextBlock Text="Тип: "
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Grid.Column="2"
                           Grid.Row="0"/>

                <ComboBox x:Name="cmbBoxSortType"
                          Grid.Column="3"
                          Grid.Row="0"
                          SelectionChanged="cmbBoxSortType_SelectionChanged">
                    <ComboBox.Items>
                        <TextBlock Text="По возрастанию"/>
                        <TextBlock Text="По убыванию"/>
                    </ComboBox.Items>

                </ComboBox>
            </Grid>
        </Grid>

        <ListView x:Name="LviewAnimal"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           HorizontalAlignment="Center"
           BorderThickness="0"
           Grid.Column="0"
           Grid.Row="1"
           Grid.ColumnSpan="2">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>


            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                        BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0"
                       Grid.Column="0"
                       Grid.RowSpan="7">

                                <Image.Source>
                                    <Binding Path="Photo">
                                        <Binding.TargetNullValue>
                                            <ImageSource>
                                                /ZooApp;component/images/student.png
                                            </ImageSource>
                                        </Binding.TargetNullValue>
                                    </Binding>
                                </Image.Source>

                            </Image>

                            <TextBlock Text="№ :Животного: "
                           Grid.Row="0"
                           Grid.Column="1"/>

                            <TextBox Text="{Binding AnimalId}"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Grid.Row="0"
                         Grid.Column="2"
                         Grid.ColumnSpan="4"/>

                            <TextBlock Text="Парода:"
                           Grid.Row="1"
                           Grid.Column="1"/>

                            <TextBox Text="{Binding LastName}"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Grid.Row="1"
                     Grid.Column="2"
                     Grid.ColumnSpan="4"/>

                            <TextBlock Text="Имя:"
                         Grid.Row="2"
                         Grid.Column="1"/>

                            <TextBox Text="{Binding FirstName}"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Grid.Row="2"
                     Grid.Column="2"
                     Grid.ColumnSpan="4"/>

                            <TextBlock Text="Дата рождения:"
                         Grid.Row="4"
                         Grid.Column="1"/>

                            <TextBox Text="{Binding BirthDate,
                    StringFormat={}{0:dd.MM.yyyy}}"
                     TextWrapping="Wrap"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Grid.Row="4"
                     Grid.Column="2"
                     Grid.ColumnSpan="4"/>

                            <TextBlock Text="Адресс:"
                         Grid.Row="5"
                         Grid.Column="1"/>

                            <TextBox Text="{Binding Address}"
                        TextWrapping="Wrap"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Grid.Row="5"
                     Grid.Column="2"
                          Grid.ColumnSpan="4"/>


                            <Button x:Name="btnEdit"
                        Content="&#9999;"
                        Grid.Column="3"
                        Grid.Row="0"
                        Click="btnEdit_Click"/>

                            <Button x:Name="btnDelete"
                        Content="&#10005;"
                        Grid.Column="4"
                        Grid.Row="0"
                        Click="btnDelete_Click"/>

                            <Button x:Name="btnContact"
                        Content="&#9638;"
                        Grid.Column="3"
                        Grid.Row="6"
                        Click="btnContact_Click"/>

                            <Button x:Name="btnMarks"
                        Content="&#127891;"
                        Grid.Column="4"
                        Grid.Row="6"
                        Click="btnMarks_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Column="0"
      Grid.Row="2"
      Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Left"
                Grid.Column="0">

                <TextBlock Text="Студентов на странице: "/>

                <ComboBox x:Name="cmbBoxStudentCount"
                  Width="80"
                  SelectionChanged="cmbBoxStudentCount_SelectionChanged">
                    <ComboBox.Items>
                        <TextBlock Text="Все"/>
                        <TextBlock Text="4"/>
                        <TextBlock Text="8"/>
                        <TextBlock Text="12"/>
                        <TextBlock Text="16"/>
                        <TextBlock Text="20"/>
                        <TextBlock Text="24"/>
                    </ComboBox.Items>

                </ComboBox>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Grid.Column="1">

                <Button x:Name="btnHome"
                Content="&#10074;&#9664;&#9664;"
                Click="btnHome_Click"/>

                <Button x:Name="btnPrev"
                Content="&#9664;"
                Click="btnPrev_Click"/>

                <TextBox x:Name="txtBoxCurrentPage"
                 Width="50"
                 TextAlignment="Center"
                 TextChanged="txtBoxCurrentPage_TextChanged"/>

                <TextBox Text=" / "
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                <TextBox x:Name="txtBoxTotalPage"
                 Width="50"
                 TextAlignment="Center"
                 IsReadOnly="True"/>

                <Button x:Name="btnNext"
                Content="&#9654;"
                Click="btnNext_Click"/>

                <Button x:Name="btnEnd"
                Content="&#9654;&#9654;&#10074;"
                Click="btnEnd_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Grid.Column="2">

                <TextBlock Text="Всего студентов: "/>

                <TextBlock x:Name="txtBlockStudentCount"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
